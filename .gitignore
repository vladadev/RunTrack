# ---------------------------------------------------------------
# .gitignore za .NET MAUI projekat
# Sve navedeno ispod se NE cuva u git-u, jer se automatski
# generise prilikom prevodjenja (build-a). Bez ovog fajla bi
# repozitorijum narastao na vise GB smeca.
# ---------------------------------------------------------------

# Rezultati prevodjenja (build output)
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/

# Visual Studio privremeni fajlovi i korisnicka podesavanja
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.csproj.user
*.rsuser

# Rider / VS Code
.idea/
# Paznja: mora ".vscode/*", a NE ".vscode/". Ako se iskljuci ceo folder,
# git u njega ni ne ulazi, pa izuzeci ispod (!) nemaju efekta.
.vscode/*
!.vscode/launch.json
!.vscode/settings.json

# NuGet paketi (skidaju se automatski komandom dotnet restore)
*.nupkg
packages/
!packages/build/

# Android build artefakti
*.apk
*.aab
*.keystore
!debug.keystore

# Lokalna SQLite baza (podaci sa uredjaja, ne ide u repo)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Tajne / kredencijali - NIKAD ne smeju u public repo
appsettings.Development.json
appsettings.Local.json
secrets.json
.env
*.pfx

# Windows / macOS sistemski fajlovi
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Publish output
publish/
[Pp]ublish[Pp]rofiles/*.user
