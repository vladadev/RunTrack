<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PrvaAplikacijaApp.Stranica2"
             Title="Stranica2">
    <ContentPage.Resources>
        <Color x:Key="CrvenaBoja">Red</Color>
        <Style x:Key="ZeleniView" TargetType="View">
            <Setter Property="BackgroundColor" Value="LimeGreen"></Setter>
        </Style>
        <Style x:Key="ZutiView" TargetType="View">
            <Setter Property="BackgroundColor" Value="Yellow"></Setter>
        </Style>
        <Style x:Key="LabelaIzvedeniStil_BasedOn"
               TargetType="Label"
               BasedOn="{StaticResource ZeleniView}">
            <Setter Property="TextColor" Value="BlueViolet"></Setter>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="VerticalOptions" Value="Center"></Setter>
            <Setter Property="HorizontalOptions" Value="Center"></Setter>
        </Style>
        <Style x:Key="LabelaIzvedeniStil_Dinamicki"
               TargetType="Label"
               BaseResourceKey="ZeleniView">
            <Setter Property="TextColor" Value="BlueViolet"></Setter>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="VerticalOptions" Value="Center"></Setter>
            <Setter Property="HorizontalOptions" Value="Center"></Setter>
        </Style>
        <Style 
               TargetType="Button"
               Class="Zaobljeno_Dugme">
            <Setter Property="CornerRadius" Value="20"></Setter>
        </Style>
        <Style 
               TargetType="Button"
               Class="Zaobljeno_Dugme">
            <Setter Property="CornerRadius" Value="20"></Setter>
        </Style>
        <Style 
               TargetType="Button"
               Class="Rotirano_Dugme">
            <Setter Property="Rotation" Value="45"></Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="BackgroundColor" Value="Yellow"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="TextColor" Value="Blue"/>
        </Style>
        <Style x:Key="CrvenoDugme" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource CrvenaBoja}"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="TextColor" Value="Black"/>
        </Style>
        
    </ContentPage.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="200" />
            <RowDefinition Height="*" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition>
                <ColumnDefinition.Width>
                    2*
                </ColumnDefinition.Width>
            </ColumnDefinition>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <VerticalStackLayout>
            <Label 
            Text="Welcome to .NET MAUI!"
            Style="{StaticResource LabelaIzvedeniStil_Dinamicki}" />
            <Button
            x:Name="btn00"
            Text="btn 00"
                StyleClass="Rotirano_Dugme"/>
        </VerticalStackLayout>
        <Button
            Grid.Row="1"
            Grid.Column="1"
            StyleClass="Zaobljeno_Dugme"
            x:Name="btn11"
            Clicked="btn11_Clicked"
            Text="btn 11"/>
        <Button
            x:Name="btn22"
            Text="BTN 22"
            Style="{StaticResource CrvenoDugme}"
            StyleClass="Zaobljeno_Dugme, Rotirano_Dugme"
            Grid.Row="2"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Grid.RowSpan="1"/>
        <Label
            Grid.Row="3"
            Grid.Column="2"
            Style="{StaticResource LabelaIzvedeniStil_BasedOn}"
            Text="labela red 3 kolona 2"/>
    </Grid>
</ContentPage>